# Дев через Tailscale. Ім'я машини в tailnet стабільне — на відміну від
# LAN-IP, який видавався по DHCP і стрибав (.102 → .103 → .101), ламаючи
# запити щоразу. Тепер до цього прив'язуватись можна.
#
# HTTPS, бо сертифікат від Let's Encrypt на це саме ім'я лежить у
# backend/cert (див. web/vite.config.ts і backend/src/main.ts). Обидві
# сторони мають бути на HTTPS: сторінка по HTTPS не достукається до
# HTTP-API, браузер заблокує як mixed content.
#
# Сертифікат виданий лише на це ім'я, тож і з ноутбука відкривай саме його,
# а не localhost — інакше браузер лаятиметься на невідповідність імені.
#
# Порт 10000, а не 3001 — це Tailscale Funnel. Телефон, на якому Tailscale
# не стоїть, у тайлнет не потрапляє, тож 3001 для нього просто не існує.
# Funnel виставляє машину в публічний інтернет, але вміє лише три порти:
# 443, 8443 і 10000. 443 зайнятий іншим проєктом, тож фронт живе на 8443,
# а API — тут. Мапінг ставиться так (раз на машину, переживає перезапуски):
#
#   tailscale funnel --bg --https=8443  https+insecure://localhost:5173
#   tailscale funnel --bg --https=10000 https+insecure://localhost:3001
#
# З ноутбука це теж працює: MagicDNS резолвить ім'я в тайлнет-адресу, тож
# трафік іде напряму, а не через інтернет.
#
# Вимкнути: tailscale funnel --https=8443 off (і те саме для 10000).

# ---------------------------------------------------------------------------

# Read by the browser — inlined into the client bundle at build time.
NEXT_PUBLIC_API_URL=https://kucher-laptop.tailb58329.ts.net:10000

# The same value, for Server Components and app/sitemap.ts. A separate variable
# because this one never reaches the browser.
API_URL=https://kucher-laptop.tailb58329.ts.net:10000

# Where canonical URLs, hreflang and the sitemap are built from. In development
# that is the dev address itself — otherwise the metadata would point at a
# production site that does not exist yet.
NEXT_PUBLIC_SITE_URL=https://kucher-laptop.tailb58329.ts.net:8443

NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Sign in with Google: the OAuth client id (type "Web application") from
# Google Cloud Console -> APIs & Services -> Credentials. The same value goes
# into the API's GOOGLE_CLIENT_ID. Every origin the site is opened from —
# this dev address included — must be listed under "Authorized JavaScript
# origins" on that client, or Google refuses to draw the button.
# Empty = no Google button, and the CSP doesn't let accounts.google.com in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------

# Аналітика. Plausible, бо він не ставить cookie — тобто таблиця cookie в
# політиці конфіденційності лишається правдивою, а банер — чесним. Лічильник
# усе одно вмикається лише після згоди на категорію «аналітика» (див.
# components/Analytics.tsx і lib/consent.ts).
#
# Порожнє значення = лічильника немає взагалі: скрипт не рендериться, і CSP
# не пускає його домен. Саме тому локально ніхто не рахує сам себе.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Для self-hosted інстансу. За замовчуванням — хмарний plausible.io.
NEXT_PUBLIC_PLAUSIBLE_HOST=

# Токен підтвердження власності з Google Search Console (тип «HTML tag»,
# значення атрибута content). Поки порожній — мета-тег не рендериться.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sentry. DSN проєкту фронтенду; порожній — Sentry не ініціалізується взагалі.
NEXT_PUBLIC_SENTRY_DSN=
