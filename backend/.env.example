# Copy to .env and fill in. .env itself is gitignored.

# ---------------------------------------------------------------- required --

# Signing keys. Different values, at least 32 characters each — the process
# refuses to start otherwise, deliberately: a default here would be a secret
# everyone who has read the repository knows, and it would fail silently.
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

DB_HOST=
DB_PORT=4000
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# ------------------------------------------------------------- environment --

# 'production' in production, and nothing else anywhere. It isn't cosmetic:
# config/cors.ts allows localhost and private-range origins outside
# production, and only the explicit CORS_ORIGINS list inside it.
NODE_ENV=

PORT=3001

# Where the web app is served from. Origins allowed to call this API, comma
# separated — scheme and port included, no trailing slash. Falls back to
# WEB_URL when unset.
#   https://viktorumm.com
CORS_ORIGINS=
WEB_URL=

# Reverse proxies in front of this process. Leave empty in development, where
# nothing is in front and the socket address is the truth.
#
# In production the chain is Cloudflare -> Caddy -> here, so '2'. Getting this
# wrong in the permissive direction is worse than leaving it off: forwarded
# addresses are just headers, and trusting them unconditionally hands every
# attacker a private rate-limit bucket per forged address. See config/proxy.ts.
TRUST_PROXY=

# ---------------------------------------------------------------- services --

# Uploads. Without these, image upload fails outright.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments. A gateway missing its keys is simply not offered — and callbacks
# for it are refused rather than trusted, since an unset key can't verify a
# signature. Both are optional.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
WAYFORPAY_DOMAIN=

# Where the gateways send their callbacks. Must be reachable from the public
# internet — a Tailscale or LAN address will never be called back.
PAYMENTS_CALLBACK_URL=

NOVA_POSHTA_API_KEY=

# Mail. Unset means letters are recorded in the outbox as skipped rather than
# queued, so local runs stay inspectable without an SMTP host.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Unset means every Telegram notification is a logged no-op.
TELEGRAM_BOT_TOKEN=
