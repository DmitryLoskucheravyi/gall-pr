/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp
# /temp does double duty: multer stages uploads here on their way to Cloudinary,
# and it is also where this project keeps its schema migrations. So ignore the
# contents but keep the .sql files — the uploads are transient and none of
# git's business, while the migrations are the record of how the database got
# to be the shape it is.
#
# Ignoring the whole directory, as this did at first, quietly dropped three new
# migrations out of the repository while the fourteen already committed stayed
# behind and made it look fine.
/temp/*
!/temp/*.sql

# Local dev TLS certificate, regenerate with `node generate-cert.js`. Self-signed
# and only used to get a secure context when serving over a LAN IP — but a
# private key is a private key, and it has no business in version control.
/cert

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
